DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/access
# SEED_USERS ниже — заведомо публичные демонстрационные токены для локальной
# разработки и тестов, а не секреты. Не используйте такие значения (и такой
# способ выдачи токенов) в проде.
SEED_USERS=alice:employee:token-alice,bob:employee:token-bob,security-user:security:token-sec
SEED_RESOURCES=gitlab:bob:normal,analytics-dashboard:alice:normal,production-database:bob:high,broken-service:bob:normal
PROVISIONING_FAIL_RESOURCE_NAMES=broken-service
